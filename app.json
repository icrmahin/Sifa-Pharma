{
  "expo": {
    "name": "Sifa-Pharma",
    "slug": "sifa-pharma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo/sifa-logo-dark.png",
    "scheme": "sifapharma",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo/sifa-logo-dark.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F7F4",
        "foregroundImage": "./assets/images/logo/sifa-logo-dark.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sifapharma.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo/sifa-logo-dark.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F7F4",
          "image": "./assets/images/logo/sifa-logo-dark.png",
          "imageWidth": 88
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "324b0d83-0252-4e34-b6f0-6e80373377bd"
      }
    }
  }
}
